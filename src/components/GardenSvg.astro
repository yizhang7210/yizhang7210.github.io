---
import { getCollection } from 'astro:content';
import { getSiteConfig } from '../config';
import { stoneLook as look } from './stoneLook';
import { stoneFill, stoneEdge, flowerPetal, flowerCentre, flowerOutline } from './gardenColors';

// The garden itself. Drawn in two variants: 'wide' for desktop, and 'narrow' for phones — cropped
// tight to the island with bigger stones and name-only labels, so it stays readable on a small screen.
interface Props {
  variant: 'wide' | 'narrow';
}
const { variant } = Astro.props;
const narrow = variant === 'narrow';
const config = await getSiteConfig();
const uid = narrow ? 'jbn' : 'jb'; // prefix for this drawing's SVG ids

const entries = await getCollection('companies');
const sorted = entries
  .map((e) => ({ ...e.data, slug: e.id.replace(/\.md$/, '').replace(/^\d+-/, '') }))
  .sort((a, b) => a.order - b.order);

const svgWidth = 1000;
// The garden is laid out on a 1000 × 1200 grid, then squashed a little vertically to keep it compact.
// Only positions are squashed — stones, flowers and text keep their true shapes.
const yScale = 0.95;
const svgHeight = 1200 * yScale;
// Wide: a white margin round the garden so its ragged outline is never cut flat by the canvas edge.
// Narrow: crop close to the island so the garden fills the phone's width.
const pad = 110;
const view = narrow ? { x: 30, y: 70, w: 965, h: 1170 } : { x: -pad + 100, y: -pad + 180, w: svgWidth + pad * 2 - 220, h: svgHeight + pad * 2 - 190 };

const countryColors: Record<string, string> = config.countryColors;
const defaultColor = config.defaultCountryColor;
const colorFor = (c: string) => countryColors[c] || defaultColor;
const nameFill = look.nameFill;

// Every stone shares one shape and size; scope is shown by the flowers growing round it.
const scopes = sorted.map((c) => c.scope);
const minScope = Math.min(...scopes);
const maxScope = Math.max(...scopes);
const scopeT = (scope: number) => (scope - minScope) / (maxScope - minScope); // 0 = narrowest role, 1 = broadest
const stoneRoundness = 0.45;
function shapeFor(scale: number) {
  const r = 58 * scale; // radius of the equal-area circle
  const aspect = 0.62 + 0.36 * stoneRoundness; // height / width
  return { rx: r / Math.sqrt(aspect), ry: r * Math.sqrt(aspect) };
}
const ryRatio = 0.74; // ghost stones

// --- Deterministic randomness so the garden is stable across builds ---
function mulberry32(a: number) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20260408);
const jitter = (amp: number) => (rand() - 0.5) * 2 * amp;

type Pt = { x: number; y: number };

// Catmull-Rom control points for segment i of an open curve.
function segmentControls(pts: Pt[], i: number) {
  const p0 = pts[i - 1] || pts[i];
  const p1 = pts[i];
  const p2 = pts[i + 1];
  const p3 = pts[i + 2] || p2;
  return {
    p1,
    c1: { x: p1.x + (p2.x - p0.x) / 6, y: p1.y + (p2.y - p0.y) / 6 },
    c2: { x: p2.x - (p3.x - p1.x) / 6, y: p2.y - (p3.y - p1.y) / 6 },
    p2,
  };
}

// Smooth open path through a set of points (Catmull-Rom -> cubic bezier).
function smoothPath(pts: Pt[]) {
  if (pts.length < 2) return '';
  let d = `M ${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const { c1, c2, p2 } = segmentControls(pts, i);
    d += ` C ${c1.x.toFixed(1)} ${c1.y.toFixed(1)}, ${c2.x.toFixed(1)} ${c2.y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
  }
  return d;
}

// Closed rock outline around (cx, cy): a jittered polygon with lightly rounded corners, so it
// reads as chipped and faceted. `roundness` (0–1) adds sides, evens them out and softens the
// corners until the outline is nearly a circle; without it you get the default chipped rock.
function blobPath(cx: number, cy: number, rx: number, ry: number, roundness?: number) {
  const t = roundness ?? -1;
  const n = t < 0 ? 9 : Math.round(7 + 6 * t);
  const angleJitter = t < 0 ? 0.28 : 0.32 * (1 - t) + 0.04;
  const radiusJitter = t < 0 ? 0.1 : 0.13 * (1 - t) + 0.025;
  const offset = rand() * Math.PI * 2;
  const pts = Array.from({ length: n }, (_, i) => {
    const ang = offset + ((i + jitter(angleJitter)) / n) * Math.PI * 2;
    const noise = 1 + jitter(radiusJitter);
    return { x: cx + Math.cos(ang) * rx * noise, y: cy + Math.sin(ang) * ry * noise };
  });
  const k = t < 0 ? 14 : 15 - 9.5 * t; // larger = tighter corners (Catmull-Rom uses 6)
  let d = `M ${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;
  for (let i = 0; i < n; i++) {
    const p0 = pts[(i - 1 + n) % n];
    const p1 = pts[i];
    const p2 = pts[(i + 1) % n];
    const p3 = pts[(i + 2) % n];
    const cp1x = p1.x + (p2.x - p0.x) / k;
    const cp1y = p1.y + (p2.y - p0.y) / k;
    const cp2x = p2.x - (p3.x - p1.x) / k;
    const cp2y = p2.y - (p3.y - p1.y) / k;
    d += ` C ${cp1x.toFixed(1)} ${cp1y.toFixed(1)}, ${cp2x.toFixed(1)} ${cp2y.toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
  }
  return d + ' Z';
}

// --- The spine: a question mark. Starts at the bottom of the stem, rises and swings right, climbs
// the right side, then curls back left over the top and trails off into the future. ---
const spine: Pt[] = [
  { x: 295, y: 1150 },
  { x: 330, y: 1025 },
  { x: 430, y: 912 },
  { x: 665, y: 778 },
  { x: 785, y: 625 },
  { x: 792, y: 485 },
  { x: 722, y: 372 },
  { x: 600, y: 318 },
  { x: 468, y: 298 },
  { x: 368, y: 250 },
  { x: 318, y: 160 },
  { x: 305, y: 70 },
  { x: 300, y: 0 },
].map((p) => ({ x: p.x, y: p.y * yScale }));

// Densely sample the spine so we can walk along it by arc length.
const dense: Pt[] = [];
for (let i = 0; i < spine.length - 1; i++) {
  const { p1, c1, c2, p2 } = segmentControls(spine, i);
  for (let k = 0; k < 80; k++) {
    const t = k / 80;
    const u = 1 - t;
    dense.push({
      x: u * u * u * p1.x + 3 * u * u * t * c1.x + 3 * u * t * t * c2.x + t * t * t * p2.x,
      y: u * u * u * p1.y + 3 * u * u * t * c1.y + 3 * u * t * t * c2.y + t * t * t * p2.y,
    });
  }
}
dense.push(spine[spine.length - 1]);
const cum = [0];
for (let i = 1; i < dense.length; i++) cum.push(cum[i - 1] + Math.hypot(dense[i].x - dense[i - 1].x, dense[i].y - dense[i - 1].y));
const spineLength = cum[cum.length - 1];

// Interior of the hook — used to decide which side of the path is "outside".
const hookCentre = { x: 480, y: 600 };

function pointAt(s: number) {
  const target = Math.min(Math.max(s, 0), spineLength);
  let i = 1;
  while (i < cum.length - 1 && cum[i] < target) i++;
  const a = dense[i - 1];
  const b = dense[i];
  const seg = cum[i] - cum[i - 1] || 1;
  const t = (target - cum[i - 1]) / seg;
  const x = a.x + (b.x - a.x) * t;
  const y = a.y + (b.y - a.y) * t;
  const len = Math.hypot(b.x - a.x, b.y - a.y) || 1;
  const tx = (b.x - a.x) / len;
  const ty = (b.y - a.y) / len;
  // Outward normal: whichever perpendicular points away from the hook's interior.
  let nx = ty;
  let ny = -tx;
  if (nx * (x - hookCentre.x) + ny * (y - hookCentre.y) < 0) {
    nx = -nx;
    ny = -ny;
  }
  return { x, y, tx, ty, nx, ny };
}

// Radius of an ellipse measured along a direction — lets stones pack evenly as the path turns.
const radiusAlong = (rx: number, ry: number, dx: number, dy: number) => (rx * ry) / Math.hypot(ry * dx, rx * dy);

type Stone = {
  company: (typeof sorted)[number];
  x: number;
  y: number;
  rx: number;
  ry: number;
  nx: number;
  ny: number;
  outline: string;
  fill: string;
  edge: string;
  isParallel: boolean;
  fullStars: number;
  halfStar: boolean;
  startYear: number;
  endYear: number | null;
};

function makeStone(company: (typeof sorted)[number], x: number, y: number, rx: number, ry: number, nx: number, ny: number, isParallel = false): Stone {
  const color = colorFor(company.country);
  const stars = company.rating / 2;
  return {
    company,
    x,
    y,
    rx,
    ry,
    nx,
    ny,
    outline: blobPath(x, y, rx, ry, stoneRoundness),
    fill: stoneFill(color),
    edge: stoneEdge(color),
    isParallel,
    fullStars: Math.floor(stars),
    halfStar: stars % 1 >= 0.5,
    startYear: parseInt(company.startDate.split('-')[0]),
    endYear: company.endDate === 'present' ? null : parseInt(company.endDate.split('-')[0]),
  };
}

// --- Walk the stones along the spine, nearly touching, like the stepping stones of a garden ---
const mainCompanies = sorted.filter((c) => c.track !== 'parallel');
const stoneGap = narrow ? 60 : 46;
const startMargin = 18;
const stoneSpanFraction = narrow ? 0.76 : 0.78; // the rest of the spine is left for the future

function walk(scale: number) {
  const placed: { s: number; rx: number; ry: number }[] = [];
  let s = 0;
  mainCompanies.forEach((company, idx) => {
    const { rx, ry } = shapeFor(scale);
    if (idx === 0) {
      const p = pointAt(0);
      s = startMargin + radiusAlong(rx, ry, p.tx, p.ty);
    } else {
      // Step along the spine until the straight-line gap between the two stones is clear —
      // arc length alone would let stones crowd each other where the path bends.
      const prev = placed[idx - 1];
      const a = pointAt(prev.s);
      s = prev.s;
      for (;;) {
        s += 2;
        const b = pointAt(s);
        const d = Math.hypot(b.x - a.x, b.y - a.y) || 1;
        const ux = (b.x - a.x) / d;
        const uy = (b.y - a.y) / d;
        if (d >= radiusAlong(prev.rx, prev.ry, ux, uy) + stoneGap + radiusAlong(rx, ry, ux, uy) || s >= spineLength) break;
      }
    }
    placed.push({ s, rx, ry });
  });
  const last = placed[placed.length - 1];
  const lp = pointAt(last.s);
  return { placed, end: last.s + radiusAlong(last.rx, last.ry, lp.tx, lp.ty) };
}

// Scale the stones so the run of them fills the intended share of the spine.
const unit = walk(1);
const gapTotal = startMargin + stoneGap * (mainCompanies.length - 1);
const stoneScale = (spineLength * stoneSpanFraction - gapTotal) / (unit.end - gapTotal);
const layout = walk(stoneScale);

const mainStones: Stone[] = mainCompanies.map((company, idx) => {
  const { s, rx, ry } = layout.placed[idx];
  const p = pointAt(s);
  const sway = (idx % 2 === 0 ? 1 : -1) * 6 + jitter(3); // gentle stagger either side of the path
  return makeStone(company, p.x + p.nx * sway, p.y + p.ny * sway, rx, ry, p.nx, p.ny);
});

const pathD = smoothPath(spine);

// Parallel roles sit just inside the hook, beside their sequential neighbours.
const parallelStones: Stone[] = sorted
  .filter((c) => c.track === 'parallel')
  .map((company) => {
    const prev = mainStones.filter((s) => s.company.order < company.order).pop() || mainStones[0];
    const next = mainStones.find((s) => s.company.order > company.order) || prev;
    const nx = (prev.nx + next.nx) / 2;
    const ny = (prev.ny + next.ny) / 2;
    const { rx, ry } = shapeFor(stoneScale * 0.8);
    const reach = Math.max(prev.rx, next.rx) + rx + 66;
    const nudge = { x: -45, y: -35 }; // a little up and to the left, into the open lawn
    return makeStone(company, (prev.x + next.x) / 2 - nx * reach + nudge.x, (prev.y + next.y) / 2 - ny * reach + nudge.y, rx, ry, 0, 1, true);
  });

const branches = parallelStones.map((p) => {
  const anchor = mainStones.filter((s) => s.company.order < p.company.order).pop() || mainStones[0];
  return { x1: anchor.x, y1: anchor.y, x2: p.x, y2: p.y };
});

const allStones = [...mainStones, ...parallelStones];

// --- What's next: one more stone, marked "?", on the next stepping spot after today ---
const lastPlaced = layout.placed[layout.placed.length - 1];
const nextShape = shapeFor(stoneScale);
let nextS = lastPlaced.s;
{
  const a = pointAt(lastPlaced.s);
  for (;;) {
    nextS += 2;
    const b = pointAt(nextS);
    const d = Math.hypot(b.x - a.x, b.y - a.y) || 1;
    const ux = (b.x - a.x) / d;
    const uy = (b.y - a.y) / d;
    if (d >= radiusAlong(lastPlaced.rx, lastPlaced.ry, ux, uy) + stoneGap + radiusAlong(nextShape.rx, nextShape.ry, ux, uy) || nextS >= spineLength) break;
  }
}
const nextStone = (() => {
  const p = pointAt(nextS);
  const sway = (mainStones.length % 2 === 0 ? 1 : -1) * 6;
  const x = p.x + p.nx * sway;
  const y = p.y + p.ny * sway;
  const color = colorFor('USA');
  return { x, y, ...nextShape, outline: blobPath(x, y, nextShape.rx, nextShape.ry, stoneRoundness), fill: stoneFill(color), edge: stoneEdge(color) };
})();
const nextEnd = nextS + radiusAlong(nextShape.rx, nextShape.ry, pointAt(nextS).tx, pointAt(nextS).ty);

// --- Past that the spine carries on, fading out, with a couple of faint future steps ---
const ghostStones = [
  { s: nextEnd + 40, rx: 30, opacity: 0.45 },
].map((g) => {
  const p = pointAt(g.s);
  const ry = g.rx * ryRatio;
  return { x: p.x, y: p.y, rx: g.rx, ry, opacity: g.opacity, outline: blobPath(p.x, p.y, g.rx, ry) };
});
const fadeFrom = pointAt(nextEnd);
// The ? stone already says "what's next", so the trail only runs a short way past it before fading.
const trailEnd = Math.min(nextEnd + 95, spineLength);
const fadeTo = pointAt(trailEnd);

// --- Decorative greenery, scattered deterministically ---
// Each bush is a cluster of leaf masses, dark at the base and lit toward the top-left;
// the foliage filter roughens the edges into leaves.
type Circle = { cx: number; cy: number; r: number; fill: string };
const leafShades = ['#3a5f2a', '#4a7834', '#5d9040', '#74a94f', '#93c26a'];
function bush(cx: number, cy: number, scale: number): Circle[] {
  const base = 30 * scale;
  const blobs: Circle[] = [];
  leafShades.forEach((fill, layer) => {
    const lift = layer * 0.16; // lighter layers sit higher and further toward the light
    const count = 7 - layer;
    for (let i = 0; i < count; i++) {
      const ang = rand() * Math.PI * 2;
      const dist = rand() * (1 - layer * 0.12);
      blobs.push({
        cx: cx + Math.cos(ang) * dist * base * 1.1 - lift * base * 0.6,
        cy: cy + Math.sin(ang) * dist * base * 0.8 - lift * base,
        r: base * (0.55 - layer * 0.05 + rand() * 0.2),
        fill,
      });
    }
  });
  return blobs;
}

const bushAnchors = [
  // back layer: around the top of the hook
  { x: 440, y: 200, s: 0.85 },
  { x: 335, y: 365, s: 0.95 },
  { x: 790, y: 295, s: 0.75 },
  // front layer: the big hedge filling the inside of the hook, and the foreground
  { x: 205, y: 620, s: 2.2 },
  { x: 310, y: 585, s: 2.9 },
  { x: 440, y: 640, s: 2.4 },
  { x: 270, y: 730, s: 1.85 },
  { x: 345, y: 725, s: 1.95 },
  { x: 610, y: 990, s: 1.0 },
  { x: 660, y: 970, s: 1.05 },
  { x: 750, y: 850, s: 0.75 },
].map((b) => ({ ...b, y: b.y * yScale }));
const bushes = bushAnchors.map((b) => ({ x: b.x, y: b.y, s: b.s, circles: bush(b.x + jitter(10), b.y + jitter(8), b.s) }));
const backBushCount = 3;

// Scope & responsibility: a ring of red flowers growing right round the rim of each stone. A narrow role
// gets a single flower; the broadest gets a full ring. The ring starts on the stone's inner side.
type Flower = { cx: number; cy: number; rot: number; size: number };
const flowers: Flower[] = allStones.flatMap((s) => {
  const t = scopeT(s.company.scope);
  const count = 1 + Math.round(t * 15);
  const inward = Math.atan2(hookCentre.y - s.y, hookCentre.x - s.x);
  const spread = Math.PI * 2 * (0.08 + 0.92 * t) * (count > 1 ? (count - 1) / count : 0);
  return Array.from({ length: count }, (_, i) => {
    const a = inward + (count === 1 ? 0 : (i / (count - 1) - 0.5) * spread) + jitter(0.05);
    const out = (7 + rand() * 4) * (narrow ? 1.05 : 0.95); // hug the rim
    return {
      cx: s.x + Math.cos(a) * (s.rx + out),
      cy: s.y + Math.sin(a) * (s.ry + out),
      rot: rand() * 72,
      size: (1.05 + rand() * 0.2) * (narrow ? 1 : 0.9),
    };
  });
});

// Light scatter of pebbles hugging both edges of the path.
// Distance from a point to the spine, and whether it falls on a stone — used to keep grass
// and pebbles in the right places.
function distToSpine(x: number, y: number) {
  let best = Infinity;
  for (let i = 0; i < dense.length; i += 3) best = Math.min(best, Math.hypot(dense[i].x - x, dense[i].y - y));
  return best;
}
const onStone = (x: number, y: number, pad: number) =>
  [...allStones, nextStone].some((st) => ((x - st.x) / (st.rx + pad)) ** 2 + ((y - st.y) / (st.ry + pad)) ** 2 < 1);

// Little pebbles: a scatter along the path edges, a few ringing each stone, and a cluster
// filling each gap so the stones read as separate steps.
const pebbleShades = ['#c9c4b9', '#b5b0a5', '#d6d1c6', '#a39e93', '#bfb9ad'];
const pebbles: { d: string; fill: string }[] = [];
function addPebble(x: number, y: number, r: number) {
  if (onStone(x, y, 3)) return;
  pebbles.push({ d: blobPath(x, y, r * (1.1 + rand() * 0.4), r), fill: pebbleShades[Math.floor(rand() * pebbleShades.length)] });
}
for (let s = 20; s < spineLength - 40; s += 11) {
  const p = pointAt(s);
  const off = (rand() > 0.5 ? 1 : -1) * (38 + rand() * 22);
  addPebble(p.x + p.nx * off + jitter(5), p.y + p.ny * off + jitter(5), 2.5 + rand() * 4.5);
}
allStones.forEach((st) => {
  for (let i = 0; i < 9; i++) {
    const ang = rand() * Math.PI * 2;
    const pad = 7 + rand() * 12;
    addPebble(st.x + Math.cos(ang) * (st.rx + pad), st.y + Math.sin(ang) * (st.ry + pad), 2.5 + rand() * 4);
  }
});
mainStones.slice(1).forEach((st, i) => {
  const prev = mainStones[i];
  const dx = st.x - prev.x;
  const dy = st.y - prev.y;
  const len = Math.hypot(dx, dy) || 1;
  for (let k = 0; k < 9; k++) {
    const t = 0.5 + jitter(0.12);
    const side = jitter(1) * 46;
    addPebble(prev.x + dx * t + (-dy / len) * side, prev.y + dy * t + (dx / len) * side, 2.5 + rand() * 4.5);
  }
});

// Ground cover: thousands of tiny leaves and grass tufts filling the meadow, thinning out
// where they meet the gravel. Batched into one path per shade so the SVG stays light.
const hedgeArea = { cx: 445, cy: 610 * yScale, rx: 250, ry: 230 * yScale };
// Extra ground that rounds out the island — the left flank and both bottom corners — so the
// outline bulges rather than dips.
const fillAreas = [
  { cx: 250, cy: 520, rx: 140, ry: 190 },
  { cx: 260, cy: 960, rx: 80, ry: 95 },
  { cx: 600, cy: 1040, rx: 150, ry: 130 },
].map((a) => ({ ...a, cy: a.cy * yScale, ry: a.ry * yScale }));
const leafTones = ['#c6daa8', '#bdd49d', '#b4cd93', '#cddfb1'];
const bladeTones = ['#9ec27b', '#a8c987', '#94b972'];
const leafPaths = leafTones.map(() => [] as string[]);
const bladePaths = bladeTones.map(() => [] as string[]);
const inIsland = (x: number, y: number, d: number) =>
  d < 290 ||
  [hedgeArea, ...fillAreas].some((a) => ((x - a.cx) / (a.rx + 120)) ** 2 + ((y - a.cy) / (a.ry + 120)) ** 2 < 1) ||
  bushAnchors.some((b) => Math.hypot(b.x - x, b.y - y) < 62 * b.s + 120);
for (let i = 0; i < (narrow ? 5000 : 6500); i++) {
  const x = view.x + rand() * view.w;
  const y = view.y + rand() * view.h;
  const d = distToSpine(x, y);
  if (d < 46 || (d < 62 && rand() < 0.55) || onStone(x, y, 4) || !inIsland(x, y, d)) continue;
  if (rand() < 0.62) {
    // a small leaf: two arcs, randomly turned
    const r = 4 + rand() * 4.5;
    const a = rand() * Math.PI;
    const ex = Math.cos(a) * r;
    const ey = Math.sin(a) * r;
    leafPaths[Math.floor(rand() * leafTones.length)].push(
      `M${(x - ex).toFixed(1)} ${(y - ey).toFixed(1)}A${r.toFixed(1)} ${(r * 0.6).toFixed(1)} ${((a * 180) / Math.PI).toFixed(0)} 0 1 ${(x + ex).toFixed(1)} ${(y + ey).toFixed(1)}A${r.toFixed(1)} ${(r * 0.6).toFixed(1)} ${((a * 180) / Math.PI).toFixed(0)} 0 1 ${(x - ex).toFixed(1)} ${(y - ey).toFixed(1)}Z`,
    );
  } else {
    // a tuft of 3–5 blades fanning up from one root
    const blades = 3 + Math.floor(rand() * 3);
    let d2 = '';
    for (let b = 0; b < blades; b++) {
      const lean = (b - (blades - 1) / 2) * 3 + jitter(1.4);
      const h = 8 + rand() * 7;
      d2 += `M${x.toFixed(1)} ${y.toFixed(1)}q${(lean * 0.3).toFixed(1)} ${(-h * 0.6).toFixed(1)} ${lean.toFixed(1)} ${(-h).toFixed(1)}`;
    }
    bladePaths[Math.floor(rand() * bladeTones.length)].push(d2);
  }
}
const groundLeaves = leafTones.map((fill, i) => ({ fill, d: leafPaths[i].join('') }));
const groundBlades = bladeTones.map((stroke, i) => ({ stroke, d: bladePaths[i].join('') }));

// --- The garden's own outline: a wide band hugging the path where the stones are, narrowing
// along the future trail, plus the hedge inside the hook and the bushes around the edge.
// A filter frays it into a ragged, grassy edge so the garden sits on the page like an island.
const found = cum.findIndex((c) => c > nextEnd + 10);
const splitAt = found < 0 ? dense.length - 2 : found; // the trail may run out on a crowded path
const polyline = (pts: Pt[]) => pts.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join('');
// Along the top of the hook (from Wise on) the band is narrower, so the turf doesn't bulge up over the ? stone.
const topStart = cum.findIndex((c) => c > layout.placed[5].s);
// The band starts a little way up the stem, so the bottom of the island rounds off inside the frame.
const stemStart = cum.findIndex((c) => c > 70);
const islandCoreD = polyline(dense.slice(stemStart, topStart + 1));
const capStart = cum.findIndex((c) => c > layout.placed[layout.placed.length - 1].s); // from Meta to the ? stone
const islandTopD = polyline(dense.slice(topStart, capStart + 1));
const islandCapD = polyline(dense.slice(capStart, splitAt + 1)); // narrowest, so the very top rounds off
// The turf stops a little short of the trail's end, so the top of the island stays rounded.
const islandTrailD = polyline(dense.slice(splitAt).filter((_, i) => cum[splitAt + i] < trailEnd - 200));

const yearText = (s: Stone) =>
  s.endYear && s.endYear !== s.startYear ? `${s.startYear}–${s.endYear}` : `${s.startYear}`;
const shortName = (name: string) => name.replace(/\s*\(.*?\)\s*/g, '').replace(/,.*$/, '').trim();

// Label sizes: phones get a bigger name and no rating badge (it's on the company page).
const nameSize = narrow ? 20 : 16;
const nameY = narrow ? 7 : -7;
---

<svg class={`garden ${variant}`} viewBox={`${view.x} ${view.y} ${view.w} ${view.h}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="A winding garden path of stepping stones, one per company I've worked at, curling up and trailing off into the future">
  <defs>
    <linearGradient id={`${uid}-meadow`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#d9e7c2" />
      <stop offset="100%" stop-color="#cfe0b5" />
    </linearGradient>

    <!-- soft, broad mottling over the lawn — no fine speckle -->
    <filter id={`${uid}-grass`} x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.012 0.018" numOctaves="3" seed="4" result="patches" />
      <feColorMatrix in="patches" type="matrix" values="0 0 0 0 0.52  0 0 0 0 0.66  0 0 0 0 0.38  0.8 0 0 0 -0.3" result="tufts" />
      <feTurbulence type="fractalNoise" baseFrequency="0.25" numOctaves="2" seed="9" result="blades" />
      <feColorMatrix in="blades" type="matrix" values="0 0 0 0 0.56  0 0 0 0 0.69  0 0 0 0 0.42  0 0.6 0 0 -0.22" result="specks" />
      <feMerge result="grassAll"><feMergeNode in="tufts" /><feMergeNode in="specks" /></feMerge>
      <feComposite in="grassAll" in2="SourceGraphic" operator="in" />
    </filter>

    <!-- fine grit lighting: used for gravel and rock surfaces -->
    <!-- cover the whole drawing: a box sized to the path's centre line would clip its wide stroke -->
    <filter id={`${uid}-gravelTex`} filterUnits="userSpaceOnUse" x={view.x} y={view.y} width={view.w} height={view.h}>
      <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="2" seed="2" result="n" />
      <feDiffuseLighting in="n" surfaceScale="2.2" lighting-color="#ffffff" result="lit"><feDistantLight azimuth="225" elevation="48" /></feDiffuseLighting>
      <feComposite in="lit" in2="SourceGraphic" operator="in" result="litIn" />
      <feBlend in="SourceGraphic" in2="litIn" mode="multiply" />
    </filter>
    <filter id={`${uid}-stoneTex`} x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB" set:html={look.filter} />

    <!-- leaves: ragged edges plus leafy light and shade -->
    <filter id={`${uid}-foliage`} x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.09" numOctaves="2" seed="7" result="warp" />
      <feDisplacementMap in="SourceGraphic" in2="warp" scale="16" xChannelSelector="R" yChannelSelector="G" result="shape" />
      <feTurbulence type="fractalNoise" baseFrequency="0.28" numOctaves="3" seed="11" result="leafNoise" />
      <feDiffuseLighting in="leafNoise" surfaceScale="3" lighting-color="#ffffff" result="lit"><feDistantLight azimuth="225" elevation="45" /></feDiffuseLighting>
      <feComposite in="lit" in2="shape" operator="in" result="litIn" />
      <feBlend in="shape" in2="litIn" mode="multiply" />
    </filter>

    <filter id={`${uid}-softShadow`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="7" />
    </filter>

    <!-- curved-surface shading for the pebbles: lit top-left, falling into shade bottom-right -->
    <radialGradient id={`${uid}-stoneShade`} cx="36%" cy="30%" r="78%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.38" />
      <stop offset="40%" stop-color="#ffffff" stop-opacity="0" />
      <stop offset="80%" stop-color="#000000" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0.26" />
    </radialGradient>

    <!-- the path fades out once it passes today -->
    <linearGradient id={`${uid}-trailFade`} gradientUnits="userSpaceOnUse" x1={fadeFrom.x} y1={fadeFrom.y} x2={fadeTo.x} y2={fadeTo.y}>
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#000000" />
    </linearGradient>
    <mask id={`${uid}-trailMask`} maskUnits="userSpaceOnUse" x={view.x} y={view.y} width={view.w} height={view.h}>
      <rect x={view.x} y={view.y} width={view.w} height={view.h} fill={`url(#${uid}-trailFade)`} />
    </mask>
    <filter id={`${uid}-islandEdge`} filterUnits="userSpaceOnUse" x={view.x} y={view.y} width={view.w} height={view.h}>
      <!-- a wide blur then a hard threshold melts the band into one smooth, rounded shape -->
      <feGaussianBlur in="SourceGraphic" stdDeviation="60" result="melt" />
      <feComponentTransfer in="melt" result="smooth"><feFuncA type="linear" slope="8" intercept="-2.6" /></feComponentTransfer>
      <feGaussianBlur in="smooth" stdDeviation="10" result="soft" />
      <feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="2" seed="21" result="warp" />
      <feDisplacementMap in="soft" in2="warp" scale="45" xChannelSelector="R" yChannelSelector="G" result="wobbly" />
      <feTurbulence type="fractalNoise" baseFrequency="0.55" numOctaves="1" seed="5" result="grain" />
      <feComposite in="wobbly" in2="grain" operator="arithmetic" k1="0" k2="1" k3="0.4" k4="-0.2" result="grainy" />
      <feComponentTransfer in="grainy">
        <feFuncR type="linear" slope="0" intercept="1" />
        <feFuncG type="linear" slope="0" intercept="1" />
        <feFuncB type="linear" slope="0" intercept="1" />
        <feFuncA type="linear" slope="5" intercept="-1.7" />
      </feComponentTransfer>
    </filter>
    <mask id={`${uid}-island`} maskUnits="userSpaceOnUse" x={view.x} y={view.y} width={view.w} height={view.h}>
      <g filter={`url(#${uid}-islandEdge)`} fill="#fff">
        <path d={islandCoreD} fill="none" stroke="#fff" stroke-width={narrow ? 275 : 330} stroke-linecap="round" stroke-linejoin="round" />
        <path d={islandTopD} fill="none" stroke="#fff" stroke-width={narrow ? 230 : 260} stroke-linecap="round" stroke-linejoin="round" />
        <path d={islandCapD} fill="none" stroke="#fff" stroke-width={narrow ? 190 : 210} stroke-linecap="round" stroke-linejoin="round" />
        <path d={islandTrailD} fill="none" stroke="#fff" stroke-width="200" stroke-linecap="round" stroke-linejoin="round" />
        {[hedgeArea, ...fillAreas].map((a) => <ellipse cx={a.cx} cy={a.cy} rx={a.rx} ry={a.ry} />)}
        {bushes.map((b) => <circle cx={b.x} cy={b.y} r={62 * b.s} />)}
        {parallelStones.map((st) => <ellipse cx={st.x} cy={st.y} rx={st.rx + 90} ry={st.ry + 90} />)}
      </g>
    </mask>
  </defs>

  <g mask={`url(#${uid}-island)`}>
    <rect x={view.x} y={view.y} width={view.w} height={view.h} fill={`url(#${uid}-meadow)`} />
    <rect x={view.x} y={view.y} width={view.w} height={view.h} fill="#000" filter={`url(#${uid}-grass)`} opacity="0.45" />
    {groundLeaves.map((l) => <path d={l.d} fill={l.fill} opacity="0.75" />)}
    {groundBlades.map((b) => <path d={b.d} fill="none" stroke={b.stroke} stroke-width="1.8" stroke-linecap="round" opacity="0.6" />)}

    <!-- back layer greenery -->
    {bushes.slice(0, backBushCount).map((b) => (
      <g>
        <ellipse cx={b.x + 10 * b.s} cy={b.y + 26 * b.s} rx={40 * b.s} ry={18 * b.s} fill="#1e2e14" opacity="0.28" filter={`url(#${uid}-softShadow)`} />
        <g filter={`url(#${uid}-foliage)`}>{b.circles.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} fill={c.fill} />)}</g>
      </g>
    ))}

    <!-- the gravel bed the stones are set into, fading out beyond today -->
    <g mask={`url(#${uid}-trailMask)`}>
      <path d={pathD} fill="none" stroke="#b9ae95" stroke-width="122" stroke-linecap="round" stroke-linejoin="round" opacity="0.75" filter={`url(#${uid}-softShadow)`} />
      <path d={pathD} fill="none" stroke="#e2dac7" stroke-width="106" stroke-linecap="round" stroke-linejoin="round" filter={`url(#${uid}-gravelTex)`} />
      <g filter={`url(#${uid}-gravelTex)`}>{pebbles.map((p) => <path d={p.d} fill={p.fill} stroke="#8d887d" stroke-width="0.6" />)}</g>
      {pebbles.map((p) => <path d={p.d} fill={`url(#${uid}-stoneShade)`} />)}
      {ghostStones.map((g) => (
        <path d={g.outline} fill="#a9a59c" fill-opacity={g.opacity * 0.5} stroke="#8e897e" stroke-width="1.5" stroke-dasharray="5 6" opacity={g.opacity} />
      ))}
    </g>

    <!-- branch connectors to parallel roles: a narrower side trail in the same gravel as the main path -->
    {branches.map((b) => {
      const d = `M ${b.x1} ${b.y1} Q ${(b.x1 + b.x2) / 2} ${(b.y1 + b.y2) / 2 - 40}, ${b.x2} ${b.y2}`;
      return (
        <g>
          <path d={d} fill="none" stroke="#b9ae95" stroke-width="44" stroke-linecap="round" opacity="0.75" filter={`url(#${uid}-softShadow)`} />
          <path d={d} fill="none" stroke="#e2dac7" stroke-width="36" stroke-linecap="round" filter={`url(#${uid}-gravelTex)`} />
        </g>
      );
    })}

    <!-- front layer greenery + flowers -->
    {bushes.slice(backBushCount).map((b) => (
      <g>
        <ellipse cx={b.x + 10 * b.s} cy={b.y + 26 * b.s} rx={40 * b.s} ry={18 * b.s} fill="#1e2e14" opacity="0.28" filter={`url(#${uid}-softShadow)`} />
        <g filter={`url(#${uid}-foliage)`}>{b.circles.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} fill={c.fill} />)}</g>
      </g>
    ))}
    {flowers.map((f) => (
      <g transform={`translate(${f.cx}, ${f.cy}) rotate(${f.rot}) scale(${f.size})`}>
        {[0, 72, 144, 216, 288].map((a) => <ellipse cx="0" cy="-3.6" rx="2.3" ry="3.6" fill={flowerPetal} stroke={flowerOutline} stroke-width="0.4" transform={`rotate(${a})`} />)}
        <circle cx="0" cy="0" r="1.9" fill={flowerCentre} />
      </g>
    ))}

    <!-- stones -->
    {allStones.map((s) => {
      const name = shortName(s.company.name);
      const starsLen = s.fullStars + (s.halfStar ? 1 : 0);
      const badgeW = starsLen * 12.4 + yearText(s).length * 7.2 + 22;
      return (
        <a href={`/company/${s.company.slug}/`} class="stone-link" aria-label={`${s.company.name}, ${s.company.city}`}>
          <g class={`stone ${s.isParallel ? 'parallel' : ''}`} style={`animation-delay: ${(s.company.order - 1) * 0.12}s`}>
            <ellipse cx={s.x + s.rx * 0.08} cy={s.y + s.ry * 0.22} rx={s.rx * 1.02} ry={s.ry * 0.98} fill="#2b2a24" opacity="0.4" filter={`url(#${uid}-softShadow)`} />
            <g filter={`url(#${uid}-stoneTex)`}>
              <path d={s.outline} fill={s.fill} />
            </g>
            <path d={s.outline} fill="none" stroke={s.edge} stroke-width="1.2" stroke-opacity={look.edgeOpacity} />
            <text class="stone-text" x={s.x} y={s.y + nameY} text-anchor="middle" font-size={nameSize} font-weight="800" letter-spacing="0.2" fill={nameFill}>{name}</text>
            {!narrow && (
              <>
                <rect class="stone-text" x={s.x - badgeW / 2} y={s.y + 1} width={badgeW} height="22" rx="11" fill="rgba(30, 28, 23, 0.85)" />
                <text class="stone-text" x={s.x} y={s.y + 16.5} text-anchor="middle" font-size="12" font-weight="600">
                  <tspan fill="#fcc63c" font-size="13.5" font-weight="700">{'★'.repeat(s.fullStars)}{s.halfStar ? '½' : ''}</tspan>
                  <tspan dx="5" fill="#ffffff">{yearText(s)}</tspan>
                </text>
              </>
            )}
          </g>
        </a>
      );
    })}

    <!-- what's next: an unnamed stone, no flowers yet -->
    <g class="stone" style={`animation-delay: ${sorted.length * 0.12}s`}>
      <title>What's next?</title>
      <ellipse cx={nextStone.x + nextStone.rx * 0.08} cy={nextStone.y + nextStone.ry * 0.22} rx={nextStone.rx * 1.02} ry={nextStone.ry * 0.98} fill="#2b2a24" opacity="0.4" filter={`url(#${uid}-softShadow)`} />
      <g filter={`url(#${uid}-stoneTex)`}>
        <path d={nextStone.outline} fill={nextStone.fill} />
      </g>
      <path d={nextStone.outline} fill="none" stroke={nextStone.edge} stroke-width="1.2" stroke-opacity={look.edgeOpacity} />
      <text class="stone-text" x={nextStone.x} y={nextStone.y + (narrow ? 18 : 12)} text-anchor="middle" font-size={narrow ? 52 : 34} font-weight="800" fill={nameFill}>?</text>
    </g>
  </g>
</svg>

<style>
  .garden {
    width: 100%;
    max-width: 1200px;
    height: auto;
    display: block;
    margin: var(--spacing-sm) auto 0;
  }

  /* One drawing per screen size. */
  .garden.narrow {
    display: none;
  }

  @media (max-width: 640px) {
    .garden.wide {
      display: none;
    }

    .garden.narrow {
      display: block;
      margin-top: 0;
    }
  }

  .stone-link {
    text-decoration: none;
    cursor: pointer;
  }

  .stone.parallel {
    opacity: 0.92;
  }

  .stone {
    transition: transform 0.2s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .stone-link:hover .stone {
    transform: translateY(-3px);
  }

  /* On load each stone gives a gentle double pulse, rippling along the path in order. */
  .stone {
    animation: pulse 0.75s ease-in-out 2;
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stone {
      animation: none;
    }
  }

  .stone-text {
    pointer-events: none;
  }
</style>
