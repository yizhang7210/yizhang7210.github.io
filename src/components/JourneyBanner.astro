---
import { getCollection } from 'astro:content';
import { getSiteConfig } from '../config';
import GardenSvg from './GardenSvg.astro';
import { legendDotStyle, flowerPetal, flowerCentre, flowerOutline } from './gardenColors';
const config = await getSiteConfig();

const entries = await getCollection('companies');
const countries = [...new Set(entries.sort((a, b) => a.data.order - b.data.order).map((e) => e.data.country))];
const colorFor = (c: string) => config.countryColors[c] || config.defaultCountryColor;
---

<div class="journey-banner">
  <p class="resume-link">{config.links.map((link, i) => <>{i > 0 && ' · '}<a href={link.url} target="_blank">{link.label}</a></>)}</p>

  <GardenSvg variant="wide" />
  <GardenSvg variant="narrow" />

  <div class="legend">
    <span class="legend-note"><span class="legend-rating"><span class="legend-stars">★</span> how much I enjoyed it (out of 5) ·</span>
      <svg class="legend-flower" viewBox="-6 -6 12 12" width="16" height="16" aria-label="flowers" role="img">
        {[0, 72, 144, 216, 288].map((a) => <ellipse cx="0" cy="-2.8" rx="1.8" ry="2.8" fill={flowerPetal} stroke={flowerOutline} stroke-width="0.3" transform={`rotate(${a})`} />)}
        <circle cx="0" cy="0" r="1.5" fill={flowerCentre} />
      </svg>
      ∝ scope &amp; responsibilities</span>
    <span class="legend-countries">
      {countries.map((country) => (
        <span class="legend-chip">
          <span class="legend-dot" style={legendDotStyle(colorFor(country))}></span>
          <span>{country}</span>
        </span>
      ))}
    </span>
  </div>
  <p class="hint">Click/Tap on any stone to read more</p>
</div>
<style>
  .journey-banner {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: 0 var(--spacing-lg);
    margin-top: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
  }

  .resume-link {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .legend {
    max-width: var(--max-width);
    margin: var(--spacing-sm) auto 0;
    padding: 0 var(--spacing-lg);
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm) var(--spacing-lg);
    justify-content: center;
    align-items: center;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .legend-stars {
    color: #f59e0b;
  }

  .legend-flower {
    display: inline-block;
    width: 16px;
    height: 16px;
    margin: 0 2px;
    vertical-align: -3px;
  }

  .legend-countries {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm) var(--spacing-md);
  }

  .legend-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hint {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: var(--spacing-sm) 0 0;
  }

  /* Phones: the garden runs edge to edge; text keeps the page's own side margins. */
  @media (max-width: 640px) {
    .journey-banner {
      padding: 0;
    }

    .legend,
    .hint {
      padding: 0 var(--spacing-lg);
    }

    /* the phone garden shows names only, so there are no stars to explain */
    .legend-rating {
      display: none;
    }
  }
</style>
