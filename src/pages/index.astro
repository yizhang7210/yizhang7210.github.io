---
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyBanner from '../components/JourneyBanner.astro';
import { getSiteConfig } from '../config';
const config = await getSiteConfig();
---

<BaseLayout title={`${config.name} - Professional Journey`}>
  <h1>{config.name}</h1>
  <p class="subtitle">{config.subtitle}</p>
  <JourneyBanner />
  <h2 class="section-title">Resources</h2>
  <ul class="resources">
    <li><a href="/interview-questions/">Questions I ask during interviews</a> — Information I try to find out about companies during the interview process</li>
    <li><a href="https://jamie-wong.com/post/valley-equity/" target="_blank">A potential employee's guide to Silicon Valley startup equity</a> — A framework for thinking about startup equity and compensation</li>
    <li><a href="https://medium.com/helpful-com/how-to-be-an-effective-early-stage-employee-hint-be-helpful-e681b456a01f" target="_blank">How to Be an Effective Early-Stage Employee</a> — Advice on making impact at early-stage startups</li>
    <li><a href="https://newsletter.pragmaticengineer.com/p/facebook" target="_blank">Inside Meta's Engineering Culture</a> — A detailed blog series from The Pragmatic Engineer on what it's like to work at Meta</li>
  </ul>
</BaseLayout>

<style>
  h1 {
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .subtitle {
    color: var(--color-text-muted);
    margin: var(--spacing-sm) 0 0;
  }

  .resume-link {
    margin: 0;
    font-size: 0.85rem;
  }

  .section-title {
    color: var(--color-primary);
  }

  .resources {
    line-height: 2;
  }

</style>
