---
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyBanner from '../components/JourneyBanner.astro';
---

<BaseLayout title="Yi Zhang - Professional Journey">
  <h1>Yi Zhang</h1>
  <p class="subtitle">Software Builder | Creative Problem Solver</p>
  <JourneyBanner />
  <h2 class="section-title">Resources</h2>
  <ul class="resources">
    <li><a href="/interview-questions/">Interview Questions</a> — Questions I ask companies during the interview process</li>
  </ul>
</BaseLayout>

<style>
  h1 {
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-top: var(--spacing-sm);
  }

  .section-title {
    color: var(--color-primary);
  }

  .resources {
    line-height: 2;
  }

</style>
